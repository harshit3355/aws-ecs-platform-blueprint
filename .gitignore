# Terraform
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
# Backend config names the bucket, which identifies the account.
backend.hcl
# Never commit a tfvars override; the committed terraform.tfvars holds
# non-secret defaults only.
*.auto.tfvars
override.tf
override.tf.json
*_override.tf

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# Secrets and local config
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local tooling
/tools/

# Submission artefacts, not project artefacts.
# The engineering log is the source of truth and stays in Markdown so it can
# be reviewed in a pull request; the rendered copy is an email attachment.
docs/Challenges-and-Resolutions.docx
docs/LOOM-SCRIPT.md
