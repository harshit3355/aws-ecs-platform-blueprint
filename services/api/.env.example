# Local development. Copy to .env; .env is gitignored.
# On ECS these come from the task definition, and DB_USER / DB_PASSWORD come
# from Secrets Manager rather than from any file.
APP_ENV=local
LOG_LEVEL=INFO
APP_VERSION=dev

DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=appsecret

# The local postgres image has TLS off. Production defaults to "require" and
# RDS rejects plaintext connections outright.
DB_SSLMODE=disable
